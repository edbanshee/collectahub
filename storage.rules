rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Isolated per-user uploads for devices and accessories
    match /users/{userId}/{folder}/{fileName} {
      // Public read so device and accessory photos can be viewed in the catalog
      allow read: if true;
      // Allow write only if user is logged in, matches their folder, file is <= 5MB, and is an image
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
